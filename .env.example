# VITO STT (optional - text input only if not set)
VITO_CLIENT_ID=your_client_id
VITO_CLIENT_SECRET=your_client_secret

# Asana (required)
ASANA_TOKEN=your_personal_access_token

# Notion (required)
NOTION_TOKEN=your_integration_token
NOTION_DATABASE_ID=your_database_id

# Misc
DEFAULT_AUTHOR=your_name
LOG_LEVEL=INFO
